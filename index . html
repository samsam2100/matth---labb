 m.innerHTML=`<div class="card"><div class="big">${p>=85?"🌟":p>=60?"👍":"💪"}</div><h2 style="text-align:center">نتيجتك: ${s} من 25 (${p}%)</h2><div id="st" class="box"></div><h3>مراجعة الأخطاء</h3>`+(wr.length?wr.slice(0,12).map(q=>`<div class="box"><div>${q.q}</div><small>اخترتِ: ${q.s>=0?q.o[q.s]:"—"} · الصحيح: <b>${q.o[q.a]}</b><br>${q.e}</small></div>`).join(""):"<div class='box ok'>إجابات كلها صحيحة، أحسنتِ!</div>")+"</div>";
 m.firstChild.appendChild(B("📋 خطتي والعودة",home,"pri"));flush()}
function practice(u,lv){const pool=T[lv].filter(t=>t().u==u),qs=Array.from({length:5},(_,k)=>pool[k%pool.length]()),at={i:0,ok:0};
 const show=()=>{if(at.i>=5){m.innerHTML=`<div class="card"><div class="big">🎉</div><h3 style="text-align:center">أجبتِ صحيحاً على ${at.ok} من 5</h3></div>`;m.firstChild.appendChild(B("عودة للخطة",home,"pri"));return}
  const q=qs[at.i];m.innerHTML=`<div class="card"><span class="tag">تدريب · ${U[u].n} · ${at.i+1}/5</span><h3 style="line-height:1.9">${q.q}</h3><div id="op"></div><div id="fb"></div></div>`;
  q.o.forEach((x,j)=>{const b=B("",e=>{if(q.d)return;q.d=1;const ok=j==q.a;if(ok)at.ok++;e.currentTarget.className=ok?"ok":"no";$("op").children[q.a].classList.add("ok");$("fb").innerHTML=`<div class="box ${ok?"":"hint"}">${ok?"✅ أحسنتِ":"❌ الصحيح: "+q.o[q.a]}<br>${q.e}</div>`;$("fb").appendChild(B("التالي ◂",()=>{at.i++;show()},"pri"))});b.innerHTML=x;$("op").appendChild(b)})};show()}
async function dash(){if(!SHEET_URL){alert("لم يُربط الجدول بعد");return}const pin=prompt("رمز المعلمة");if(!pin)return;
 try{const d=await (await fetch(SHEET_URL+"?pin="+encodeURIComponent(pin))).json();
  m.innerHTML='<div class="card"><h2>🔒 لوحة المعلمة</h2><div style="overflow-x:auto"><table><tr><th>الطالبة</th><th>1</th><th>2</th><th>3</th><th>4</th><th>الأضعف</th></tr>'+(d.rows||[]).map(r=>"<tr>"+[0,1,2,3,4,5].map(i=>"<td>"+esc(r[i]||"")+"</td>").join("")+"</tr>").join("")+"</table></div></div>";
  if(!(d.rows||[]).length)m.firstChild.append("لا توجد نتائج أو الرمز غير صحيح.");m.firstChild.appendChild(B("عودة",home,"pri"))}catch(e){alert("تعذّر الاتصال بالجدول")}}
$("nm").value=st.name;$("nm").oninput=e=>{st.name=e.target.value;sv();const p=$("pn");if(p)p.textContent=st.name};
$("tb").onclick=dash;addEventListener("online",flush);home();if(st.name)flush();
</script>
